<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Certificate set for the Google Fonts downloadable-font provider.

      The dev cert below is the genuine AOSP value. For release you should ALSO
      add the official *prod* cert: copy the full font_certs.xml from the
      AndroidX Downloadable Fonts sample and replace this file with it —
        https://github.com/android/user-interface-samples/tree/main/DownloadableFonts
      The base64 must match byte-for-byte, otherwise the provider silently
      rejects the request and the UI falls back to the system font (the custom
      Hanken Grotesk / Newsreader / JetBrains Mono won't load).
    -->
    <array name="com_google_android_gms_fonts_certs">
        <item>@array/com_google_android_gms_fonts_certs_dev</item>
    </array>
    <string-array name="com_google_android_gms_fonts_certs_dev">
        <item>
            
        </item>
    </string-array>
</resources>
