{
  "name": "ea-mic",
  "version": "2.5.2",
  "description": "E Mic — English voice to text (offline dictation)",
  "author": "First Iraqi Bank",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "keys": "node tools/generate-keys.js",
    "dist": "electron-builder --win",
    "publish": "electron-builder --win --publish always"
  },
  "dependencies": {
    "@babel/standalone": "^7.26.4",
    "@huggingface/transformers": "^3.3.3",
    "electron-updater": "^6.8.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "iq.fib.eamic",
    "productName": "E Mic",
    "npmRebuild": false,
    "files": [
      "src/**/*",
      "node_modules/**/*"
    ],
    "icon": "build/icon.ico",
    "win": {
      "target": "nsis-web",
      "artifactName": "EMic-Web-Setup.${ext}",
      "icon": "build/icon.ico"
    },
    "nsisWeb": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": null,
      "artifactName": "EMic-mac-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "E Mic uses the microphone to transcribe your speech to text.",
        "LSUIElement": false
      }
    },
    "dmg": {
      "title": "E Mic",
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "rudawathegw-design",
        "repo": "e-mic"
      }
    ]
  }
}
